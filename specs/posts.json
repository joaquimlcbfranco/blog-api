{
  "openapi": "3.0.3",
  "info": {
    "title": "Posts API",
    "description": "The API paths for the posts domain",
    "version": "1.0.0"
  },
  "paths": {
    "/posts": {
      "get": {
        "tags": [
          "Posts"
        ],
        "operationId": "getAllPosts",
        "summary": "Gets a list of all posts",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./model/posts.json#/components/schemas/PostsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Not Allowed"
          }
        }
      },
      "post": {
        "tags": [
          "Posts"
        ],
        "operationId": "createPost",
        "summary": "Creates a new post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./model/posts.json#/components/schemas/PostRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/posts/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "ID of the post",
          "schema": {
            "type": "integer",
            "format": "int32"
          },
          "required": true
        }
      ],
      "get": {
        "tags": [
          "Posts"
        ],
        "operationId": "getPost",
        "summary": "Gets a post by ID",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./model/posts.json#/components/schemas/PostResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Posts"
        ],
        "operationId": "updatePost",
        "summary": "Updates the specified post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./model/posts.json#/components/schemas/PostRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      }
    }
  }
}